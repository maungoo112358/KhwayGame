{
  "name": "doggame",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run lint:arch && npm test && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/core",
    "lint:arch": "node tools/arch/node_modules/dependency-cruiser/bin/dependency-cruise.mjs src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "cd tools/arch && npm install --silent"
  },
  "dependencies": {
    "pixi.js": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
